# Bez obu wartości lokalny npm run dev pomija logowanie.
# W produkcji obie są wymagane. Wpisz własne wartości; nie commituj .env.local.
APP_PASSWORD=
# Minimum 32 znaki; wygeneruj np. przez: openssl rand -hex 32
SESSION_SECRET=
# Ustaw własną nazwę w każdym projekcie (cookies nie są rozdzielane po porcie).
AUTH_COOKIE_NAME=base-session
